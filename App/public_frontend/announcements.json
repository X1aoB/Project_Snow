  "updates": [
    {
      "id": "2026-10-15-snow-adv-interface",
      "published_at": "2026-10-15T20:50:00+08:00",
      "title": "雪境界面升级",
      "summary": "界面换成以雪与白色为主的游戏风格，面对面更像视觉小说，转场与动画更顺滑。",
      "items": [
        "面对面改为全屏舞台：磨砂对白框、角色色名牌和翻页提示，并提供跳过、回看、隐藏与设置快捷菜单。",
        "九个地点各有分层雪景，随清晨、白天、黄昏和夜晚变化；室内的雪只在窗外飘落。",
        "换表情时立绘不再变得透明，登场、呼吸与动作更柔和；前往新地点时显示白雪转场和地点标题卡。",
        "通讯器改为联系人卡片和角色色气泡，设置、公告、弹窗与隐私页统一了风格。",
        "电脑端打开时显示终端开机画面，第一次进入室内时镜头会推进；手机端以锁屏开场，可从通知直接进入对应内容。",
        "对白与名牌使用霞鹜文楷，只下载用到的字；界面文字不小于 12px。动画遵循动效偏好与系统的减少动态设置。",
        "聊天记录、模型调用次数与回复计时方式保持不变。"
      ]
    },
    {
      "id": "2026-10-15-immersive-dialogue",
      "published_at": "2026-10-15T00:45:00+08:00",
      "title": "对话理解与自然赴约升级",
      "summary": "改善原作回忆、日常交流与当前行动的衔接，让邀请和场景延续更自然。",
      "items": [
        "日常聊天、原作回忆与你们共同的经历分别处理。询问过去或假设中的地点不会立即移动；需要时可在记录中查看原作出处。",
        "邀请按钮与自然表达共用地点识别，支持现有地点及「你的房间」「你那里」「那就走吧」等表达。拒绝、延后和未来邀约不会立即转场。",
        "通讯器中接受邀请后保留约定卡，可赴约或取消；打开通讯器和切换联系人不会自动移动。面对面接受当前邀约后可共同前往。",
        "未来和待定约定可在两种模式下查看或取消，尚未形成当前会合约定时不会提供立即赴约入口。",
        "赴约会在位置确认后切换场景，并显示到场事件，无需额外等待一次模型回复。",
        "重开页面继续保留已确认场景。「接着昨天聊」延续场景与有效约定；「从今天开始」结束旧场景和未履约约定，历史经历仍可保留。",
        "通过校验的日常经历独立保存在本机，每轮仅携带相关短记忆；网络中断后查询原请求结果，避免自动重新生成。"
      ]
    },
    {
      "id": "2026-10-14-chat-feedback-fixes",
      "published_at": "2026-10-14T18:20:32+08:00",
      "title": "聊天显示与模式切换修复",
      "summary": "根据本次反馈修复见面邀请、消息节奏、滚动位置和模式切换后的显示。",
      "items": [
        "修复通过通讯器提出见面邀请时可能立即报错的问题，邀请会继续通过当前模式回复，再由实际切换衔接面对面对话。",
        "调整输入提示与连续消息的显示节奏，避免多段气泡几乎同时出现；回复准备好后不再因输入提示额外等待。",
        "查看较早消息时保留阅读位置，在对话底部时继续跟随新消息。",
        "切换通讯器与面对面后，错误提示和恢复入口跟随对应对话，不再混入另一种模式。",
        "面对面对话开始后不再重复显示最初的场景描述，动作与对白按当前回复衔接。",
        "反馈会关联所选对话及对应请求，避免混用上一轮回复或另一种模式的诊断。"
      ]
    },
    {
      "id": "2026-10-14-chat-response-motion",
      "published_at": "2026-10-14T10:43:11+08:00",
      "title": "聊天反馈与模式切换优化",
      "summary": "优化回复等待与界面动效，改善模式切换和草稿保存。",
      "items": [
        "调整回复生成与显示节奏，减少回复准备好之后的额外等待，保留自然的输入提示和你选择的模型、角色与记忆设置。",
        "通讯器与面对面之间的过渡更连贯，气泡、对白框、立绘和设置面板的动效更加统一；长聊天记录切换时也更轻快。",
        "切换模式时保留各自的对白与动作草稿，修复连续点击重复到场、保存过程中草稿被覆盖的问题。",
        "重载或打开历史记录时，旧消息会直接完整显示，不再重复播放气泡入场和打字效果；新消息仍保留正常反馈。",
        "改善手机布局与返回页面后的显示，并尊重系统的减少动态效果偏好；也可以在设置中自行调整动效。",
        "回复耗时仍受所选模型与网络情况影响，我们会继续优化慢模型的等待体验。"
      ]
    },
    {
      "id": "2026-09-26-feedback-email-details",
      "published_at": "2026-09-26T00:00:00+08:00",
      "title": "反馈邮件通知更完整",
      "summary": "反馈邮件现在会附带反馈正文和可选的 QQ 联系方式，版本仍为 1.0.0。",
      "items": [
        "提交反馈后，邮件会包含反馈编号、提交时间和你填写的反馈内容。",
        "填写 QQ 时，邮件会一并附上 QQ；未填写时会明确标记为未提供。",
        "邮件仍不包含对话上下文、诊断信息、IP 地址或凭据。"
      ]
    },
    {
      "id": "2026-09-24-public-send-retrieval",
      "published_at": "2026-09-24T00:00:00+08:00",
      "title": "面对面组合消息与回复稳定性优化",
      "summary": "动作和对白可以在同一轮稳定发送，异常时可安全重试。",
      "items": [
        "面对面模式同时填写动作和对白后，发送失败会保留草稿，并可使用同一请求继续重试，避免重复消息。",
        "网络中断、排队或模型服务异常会显示更清楚的处理阶段，反馈时也会自动带上请求编号。",
        "检索回复会优先遵循当前场景、角色范围和证据来源；部分检索服务暂时不可用时会安全降级。"
      ]
    },
    {
      "id": "2026-09-09-xiaoji-1.0.0",
      "published_at": "2026-09-09T17:30:00+08:00",
      "title": "小吉终端 1.0.0：聊天更自然，模型由你选择",
      "summary": "改善表情、角色加载与文字聊天布局，新增个人 Codex 订阅连接。",
      "items": [
        "角色表情更贴近对白出现的时机，切换加入快速淡出淡入；提前准备角色图片，减少进入面对面时的等待。",
        "文字聊天放大头像，并调整消息宽度、间距与手机布局。",
        "「接着昨天聊」移入设置，默认从今天开始；切换角色时不再反复弹窗。",
        "模型设置新增「Codex 订阅」教程与个人连接器。每人使用自己的账号，配对后可选择账号支持的模型和推理强度，默认优先 Luna Max；账号不支持时由你明确选择。",
        "所选模型和强度在保存后生效。较高强度可能等待更久；额度消耗以订阅计划为准。订阅连接时暂停自动摘要，切回 API 后仍沿用你的原设置。"
      ]
    },
    {
      "id": "2026-09-09-xiaoji-characters",
      "published_at": "2026-09-09T00:00:00+08:00",
      "title": "小吉终端与全角色舞台更新",
      "summary": "22 位角色的立绘、表情和特别表现现已加入面对面通讯。",
      "items": [
        "项目现以「小吉终端」的名称与新图标与你见面。",
        "面对面通讯加入全部 22 位角色的 18 种基础表情，以及部分角色的特别表现。",
        "改善窄屏输入与角色切换体验；可在设置中减少动态效果。"
      ]
    },
    {
      "id": "2026-09-05-announcements",
      "published_at": "2026-09-05T13:00:00+08:00",
      "title": "公告与生日提醒上线",
      "summary": "站点动态和角色生日，现在可以随时查看。",
      "items": [
        "右上角的「!」可查看最新公告与角色生日。",
        "新公告只自动提示一次；角色生日统一按北京时间提醒。",
        "模型设置的人机验证已修复，获取模型列表与保存会话会显示处理进度。"
      ]
    }
  ],
