PUBLIC_ORIGIN=https://snow.xiaob.dev
PUBLIC_DEVELOPMENT_ORIGINS=
PUBLIC_ALLOW_INSECURE_DEV=false
PUBLIC_AUTO_CREATE_SCHEMA=false
PUBLIC_TRUST_PROXY_HEADERS=true
PUBLIC_ENABLED_PROVIDERS=openai,deepseek,dashscope,zhipu,moonshot
# Personal Codex connectors require one API worker and HTTPS. Enable after acceptance.
PUBLIC_SUBSCRIPTION_ENABLED=false
# Optional visit collection; each browser still requires separate consent.
PUBLIC_STATISTICS_ENABLED=false
PUBLIC_APP_VERSION=1.0.0
PUBLIC_DATA_VERSION=replace-with-release-version
PUBLIC_MEDIA_VERSION=2026.10.18.character.webp92.2
PUBLIC_MEDIA_ROOT=/srv/project-snow/media/current
PUBLIC_EXPERIENCE_NOTICE_VERSION=0.9.2
PUBLIC_ARRIVAL_PROBABILITY=1.0
PUBLIC_STICKER_VERSION=2026.08.19.sticker.1
PUBLIC_STICKER_ROOT=/srv/project-snow/media/stickers/current
TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
PUBLIC_TURNSTILE_HOSTNAME=snow.xiaob.dev
PUBLIC_TURNSTILE_MAX_AGE_SECONDS=300
PUBLIC_PRIVACY_POLICY_VERSION=0.9.2
PUBLIC_PRIVACY_EFFECTIVE_AT=2026-08-20
PUBLIC_ATTRIBUTION_URL=/public/v1/attributions
PUBLIC_MAX_PROVIDER_CALLS_PER_ACTION=2
PUBLIC_BYOK_LIFETIME_HOURS=12
# Independent rollback switches. Block streaming needs migration 0008 and
# candidate acceptance before it is explicitly enabled.
PUBLIC_CHAT_LATENCY_V2=true
PUBLIC_VERIFIED_BLOCK_STREAM=false
PUBLIC_MOTION_V2=true
# Dialogue upgrades stay disabled until exact candidate acceptance. A staging
# operator can override the reviewed flags below in the root-owned SHA-scoped file.
PUBLIC_DIALOGUE_DOMAINS_V2=false
PUBLIC_SCENE_ACTIONS_V2=false
PUBLIC_SESSION_MEMORY_V2=false
# 雪境 ADV interface skin (presentation only). Off until exact candidate
# acceptance; the same root-owned SHA-scoped file may enable it for a candidate.
PUBLIC_UI_SNOW_ADV=false
PUBLIC_STATE_KEY_ID=2026-08-19
PUBLIC_STATE_PREVIOUS_KEY_ID=
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=project_snow_documents
EMBEDDING_URL=http://embedding:8000
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
