#!/bin/sh
set -eu

# Root-owned release control plane.  The SSH deploy account may invoke this
# file through one sudoers rule, but it never receives Docker socket access.
umask 077

if [ "${PROJECT_SNOW_RELEASE_CLEAN_PID:-}" != "$$" ]; then
  exec /usr/bin/env -i \
    HOME=/root USER=root LOGNAME=root \
    LC_ALL=C \
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    PROJECT_SNOW_RELEASE_CLEAN_PID="$$" \
    /bin/sh "$0" "$@"
fi

if [ "$(id -u)" -ne 0 ]; then
  echo 'project-snow-release must run as root through its sudoers rule.' >&2
  exit 77
fi

repo=/srv/project-snow/repo
app_root="$repo/App"
inbox=/srv/project-snow/inbox
release_lock=/run/lock/project-snow-release.lock
expected_origin=https://github.com/X1aoB/Project_Snow.git
expected_public_image=ghcr.io/x1aob/project_snow-public
expected_embedding_image=ghcr.io/x1aob/project_snow-embedding
active_file=/srv/project-snow/releases/active-colour
colour_root=/srv/project-snow/releases/colours
runner_path=/usr/local/sbin/project-snow-release

operation="${1:-}"
case "$operation" in
  stage|promote|rollback)
    [ "$#" -eq 3 ] || {
      echo "Usage: project-snow-release $operation <blue|green> <40-character-main-sha>" >&2
      exit 64
    }
    colour="$2"
    requested_sha="$3"
    case "$colour" in blue|green) ;; *) echo 'Colour must be blue or green.' >&2; exit 64 ;; esac
    printf '%s\n' "$requested_sha" | grep -Eq '^[0-9a-f]{40}$' || {
      echo 'A 40-character lowercase main SHA is required.' >&2
      exit 64
    }
    ;;
  status)
    [ "$#" -eq 1 ] || { echo 'Usage: project-snow-release status' >&2; exit 64; }
    ;;
  *)
    echo 'Allowed operations: stage, promote, rollback, status.' >&2
    exit 64
    ;;
esac

cleanup_paths=""
release_signal_status=0
stage_signal_can_ack=0
stage_signal_manifest=""
stage_signal_colour=""
stage_signal_sha=""
stage_signal_public=""
stage_signal_embedding=""
stage_signal_nonce=""
stage_signal_child_pid=""
stage_signal_child_expected=0
stage_signal_restore_controller=""
release_signal_child_operation=""
switch_signal_can_ack=0
switch_signal_controller_sha=""
switch_signal_colour=""
switch_signal_sha=""
switch_signal_public=""
switch_signal_embedding=""

cleanup() {
  cleanup_status=$?
  trap - EXIT HUP INT QUIT TERM PIPE
  if [ "$release_signal_status" -ne 0 ] &&
     [ "$release_signal_child_operation" = switch ] &&
     [ "$switch_signal_can_ack" -eq 1 ]; then
    if switch_commit_is_durable; then
      cleanup_status=0
    else
      cleanup_status="$release_signal_status"
    fi
  elif [ "$release_signal_status" -ne 0 ] && [ "$stage_signal_can_ack" -eq 1 ]; then
    if stage_commit_is_durable "$stage_signal_manifest" "$stage_signal_colour" \
      "$stage_signal_sha" "$stage_signal_public" "$stage_signal_embedding" \
      "$stage_signal_nonce"; then
      cleanup_status=0
    else
      cleanup_status="$release_signal_status"
      if [ -n "$stage_signal_restore_controller" ]; then
        if ! checkout_controller "$stage_signal_restore_controller"; then
          echo 'CRITICAL: interrupted release staging could not restore its exact predecessor controller.' >&2 || true
        fi
      fi
    fi
  elif [ "$release_signal_status" -ne 0 ] && [ -n "$stage_signal_restore_controller" ]; then
    cleanup_status="$release_signal_status"
    if ! checkout_controller "$stage_signal_restore_controller"; then
      echo 'CRITICAL: interrupted release staging could not restore its exact predecessor controller.' >&2 || true
    fi
  fi
  for cleanup_path in $cleanup_paths; do
    rm -f -- "$cleanup_path" || true
  done
  exit "$cleanup_status"
}

terminate_release_signal() {
  release_signal_status="$1"
  release_signal_name="$2"
  trap '' HUP INT QUIT TERM PIPE
  if [ -z "$stage_signal_child_pid" ] && [ "$stage_signal_child_expected" -eq 1 ]; then
    stage_signal_child_pid="$(jobs -p 2>/dev/null | tail -n 1)" || stage_signal_child_pid=""
  fi
  if [ -n "$stage_signal_child_pid" ]; then
    kill -s "$release_signal_name" "$stage_signal_child_pid" 2>/dev/null || true
    wait "$stage_signal_child_pid" 2>/dev/null || true
    stage_signal_child_pid=""
  fi
  exit "$release_signal_status"
}

trap cleanup EXIT
trap 'terminate_release_signal 129 HUP' HUP
trap 'terminate_release_signal 130 INT' INT
trap 'terminate_release_signal 131 QUIT' QUIT
trap 'terminate_release_signal 143 TERM' TERM
trap 'terminate_release_signal 141 PIPE' PIPE

require_root_controlled_repo() {
  [ -d "$repo/.git" ] && [ ! -L "$repo" ] && [ ! -L "$repo/.git" ] || {
    echo 'The root-owned release repository is missing.' >&2
    return 1
  }
  [ "$(stat -c %u "$repo")" -eq 0 ] &&
    [ "$(stat -c %u "$repo/.git")" -eq 0 ] || {
      echo 'The release repository is not root-owned.' >&2
      return 1
    }
  if find "$repo" "$repo/.git" -maxdepth 0 -perm /022 -print -quit | grep -q .; then
    echo 'The release repository is writable by a non-root principal.' >&2
    return 1
  fi
  [ "$(git -C "$repo" config --get remote.origin.url)" = "$expected_origin" ] || {
    echo 'The release repository origin is not the pinned Project Snow origin.' >&2
    return 1
  }
  [ "$(git -C "$repo" config --get core.hooksPath)" = /dev/null ] || {
    echo 'Git hooks are not disabled in the release repository.' >&2
    return 1
  }
}

fetch_main() {
  require_root_controlled_repo
  git -c core.hooksPath=/dev/null -c core.fsmonitor=false \
    -C "$repo" fetch --quiet --force --prune origin \
    '+refs/heads/main:refs/remotes/origin/main'
}

require_main_commit() {
  commit_sha="$1"
  git -C "$repo" cat-file -e "$commit_sha^{commit}" 2>/dev/null || {
    echo "Commit $commit_sha is not available from the pinned repository." >&2
    return 1
  }
  [ "$(git -C "$repo" rev-parse "$commit_sha^{commit}")" = "$commit_sha" ] || return 1
  git -C "$repo" merge-base --is-ancestor "$commit_sha" refs/remotes/origin/main || {
    echo "Commit $commit_sha is not an ancestor of origin/main." >&2
    return 1
  }
}

checkout_controller() {
  commit_sha="$1"
  require_main_commit "$commit_sha" || return 1
  git -c core.hooksPath=/dev/null -c core.fsmonitor=false \
    -C "$repo" checkout --quiet --force --detach "$commit_sha" || return 1
  git -c core.hooksPath=/dev/null -c core.fsmonitor=false \
    -C "$repo" reset --quiet --hard "$commit_sha" || return 1
  git -c core.hooksPath=/dev/null -c core.fsmonitor=false \
    -C "$repo" clean -ffdx >/dev/null || return 1
  checked_out_controller="$(git -C "$repo" rev-parse HEAD)" || return 1
  [ "$checked_out_controller" = "$commit_sha" ] || return 1
  checked_out_status="$(git -C "$repo" status --porcelain --untracked-files=no)" || return 1
  [ -z "$checked_out_status" ] || {
    echo 'The trusted release checkout is not clean.' >&2
    return 1
  }
}

current_controller_sha() {
  controller_sha="$(git -C "$repo" rev-parse --verify HEAD 2>/dev/null || true)"
  printf '%s\n' "$controller_sha" | grep -Eq '^[0-9a-f]{40}$' || {
    echo 'The release controller has no valid checked-out commit.' >&2
    return 1
  }
  require_main_commit "$controller_sha"
  [ -z "$(git -C "$repo" status --porcelain --untracked-files=no)" ] || {
    echo 'The release controller checkout has tracked modifications.' >&2
    return 1
  }
  printf '%s\n' "$controller_sha"
}

fsync_release_path() {
  python3 - "$1" <<'PY'
import os
import sys

path = sys.argv[1]
flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
if os.path.isdir(path):
    flags |= getattr(os, "O_DIRECTORY", 0)
descriptor = os.open(path, flags)
try:
    os.fsync(descriptor)
finally:
    os.close(descriptor)
PY
}

resolve_installed_runner_controller() {
  runner_target_sha="$1"
  runner_installed_sha256="$2"
  runner_current_controller="$3"
  [ -f "$runner_path" ] && [ ! -L "$runner_path" ] &&
    [ "$(stat -c %u:%g:%a:%h "$runner_path")" = 0:0:755:1 ] &&
    [ "$(sha256sum "$runner_path" | awk '{print $1}')" = "$runner_installed_sha256" ] || {
      echo 'Installed release runner cannot be bound to a trusted controller.' >&2
      return 1
    }
  runner_installed_blob="$(git -C "$repo" hash-object --no-filters "$runner_path")" || return 1
  runner_history="$(git -C "$repo" rev-list --first-parent "$runner_target_sha")" || return 1
  runner_current_is_first_parent=0
  for runner_controller_candidate in $runner_history; do
    if [ "$runner_controller_candidate" = "$runner_current_controller" ]; then
      runner_current_is_first_parent=1
      candidate_runner_blob="$(git -C "$repo" rev-parse \
        "$runner_controller_candidate:App/ops/project-snow-release" 2>/dev/null)" || return 1
      if [ "$candidate_runner_blob" = "$runner_installed_blob" ]; then
        printf '%s\n' "$runner_current_controller"
        return 0
      fi
      break
    fi
  done
  [ "$runner_current_is_first_parent" -eq 1 ] || {
    echo 'Current release controller is not on the target first-parent history.' >&2
    return 1
  }
  # A current controller whose runner blob differs is an interrupted upgrade:
  # either target checkout happened before its runner rename, or the parent
  # restored the predecessor after the runner rename.  Only in this mismatch
  # state select the nearest exact blob anywhere on target's first-parent line.
  for runner_controller_candidate in $runner_history; do
    candidate_runner_blob="$(git -C "$repo" rev-parse \
      "$runner_controller_candidate:App/ops/project-snow-release" 2>/dev/null)" || continue
    if [ "$candidate_runner_blob" = "$runner_installed_blob" ]; then
      printf '%s\n' "$runner_controller_candidate"
      return 0
    fi
  done
  echo 'Installed release runner has no exact first-parent controller ancestor.' >&2
  return 1
}

runner_matches_controller() {
  bound_controller_sha="$1"
  printf '%s\n' "$bound_controller_sha" | grep -Eq '^[0-9a-f]{40}$' || return 1
  [ -f "$runner_path" ] && [ ! -L "$runner_path" ] &&
    [ "$(stat -c %u:%g:%a:%h "$runner_path" 2>/dev/null || true)" = 0:0:755:1 ] || return 1
  installed_runner_blob="$(git -C "$repo" hash-object --no-filters "$runner_path")" || return 1
  controller_runner_blob="$(git -C "$repo" rev-parse \
    "$bound_controller_sha:App/ops/project-snow-release" 2>/dev/null)" || return 1
  [ "$installed_runner_blob" = "$controller_runner_blob" ]
}

live_origin_edge_binding_matches_expected() {
  durable_live_binding=/srv/project-snow/releases/live-origin-edge-config.json
  durable_live_env_root=/srv/project-snow/runtime/origin-edge
  durable_live_origin_present=0
  durable_live_env=""
  if [ ! -e "$durable_live_binding" ] && [ ! -L "$durable_live_binding" ]; then
    return 0
  fi
  [ -f "$durable_live_binding" ] && [ ! -L "$durable_live_binding" ] &&
    [ "$(stat -c %u:%g:%a:%h "$durable_live_binding" 2>/dev/null)" = 0:0:600:1 ] || return 1
  jq -e '
    type == "object" and
    ((keys | sort) == ([
      "colour", "commit_sha", "configuration_sha256",
      "live_origin_edge_schema", "origin_edge_env_path",
      "origin_edge_env_sha256", "root", "schema_version"
    ] | sort)) and
    .schema_version == "project-snow-config-snapshot-1" and
    .live_origin_edge_schema == "project-snow-live-origin-edge-1" and
    (.colour == "blue" or .colour == "green") and
    (.commit_sha | type == "string" and test("^[0-9a-f]{40}$")) and
    (.root == ("/srv/project-snow/releases/configurations/" + .commit_sha)) and
    (.origin_edge_env_path | type == "string" and
      test("^/srv/project-snow/runtime/origin-edge/[0-9a-f]{64}\\.compose\\.env$")) and
    (.origin_edge_env_sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
    ((.configuration_sha256 | keys | sort) as $paths |
      $paths == ([
        "compose.prod.yml", "infra/Caddyfile", "infra/OriginEdge.Caddyfile",
        "infra/egress-squid.conf", "infra/neo4j-entrypoint.sh",
        "infra/postgres/postgresql.conf", "infra/public-api.Dockerfile",
        "ops/project-snow-origin-firewall.service",
        "ops/project-snow-origin-firewall.timer", "requirements-public.txt",
        "scripts/cloudflare_origin_firewall.py"
      ] | sort) or
      $paths == ([
        "compose.prod.yml", "config/origin-edge/aop-ca.pem",
        "config/origin-edge/origin-cert.pem", "infra/Caddyfile",
        "infra/OriginEdge.Caddyfile", "infra/egress-squid.conf",
        "infra/neo4j-entrypoint.sh", "infra/postgres/postgresql.conf",
        "infra/public-api.Dockerfile", "ops/project-snow-origin-firewall.service",
        "ops/project-snow-origin-firewall.timer", "requirements-public.txt",
        "scripts/cloudflare_origin_firewall.py", "scripts/install_origin_tls.py"
      ] | sort)) and
    all(.configuration_sha256[];
      type == "string" and test("^[0-9a-f]{64}$"))
  ' "$durable_live_binding" >/dev/null || return 1
  durable_live_sha="$(jq -r '.commit_sha' "$durable_live_binding")" || return 1
  durable_live_root="$(jq -r '.root' "$durable_live_binding")" || return 1
  durable_live_env="$(jq -r '.origin_edge_env_path' "$durable_live_binding")" || return 1
  durable_live_env_sha="$(jq -r '.origin_edge_env_sha256' "$durable_live_binding")" || return 1
  [ -d "$durable_live_root" ] && [ ! -L "$durable_live_root" ] || return 1
  [ -d "$durable_live_env_root" ] && [ ! -L "$durable_live_env_root" ] &&
    [ "$(stat -c %u:%g:%a "$durable_live_env_root" 2>/dev/null)" = 0:0:700 ] || return 1
  [ -f "$durable_live_env" ] && [ ! -L "$durable_live_env" ] &&
    [ "$(stat -c %u:%g:%a:%h "$durable_live_env" 2>/dev/null)" = 0:0:600:1 ] &&
    [ "${durable_live_env##*/}" = "$durable_live_env_sha.compose.env" ] &&
    [ "$(sha256sum "$durable_live_env" | awk '{print $1}')" = "$durable_live_env_sha" ] || return 1
  durable_live_paths="$(jq -r '.configuration_sha256 | keys[]' "$durable_live_binding")" || return 1
  for durable_live_path in $durable_live_paths; do
    durable_live_expected="$(jq -r --arg path "$durable_live_path" \
      '.configuration_sha256[$path]' "$durable_live_binding")" || return 1
    [ -f "$durable_live_root/$durable_live_path" ] &&
      [ ! -L "$durable_live_root/$durable_live_path" ] &&
      [ "$(sha256sum "$durable_live_root/$durable_live_path" | awk '{print $1}')" = \
        "$durable_live_expected" ] || return 1
  done
  durable_live_origin_present=1
}

switch_commit_matches_expected() {
  [ "$switch_signal_can_ack" -eq 1 ] || return 1
  printf '%s\n' "$switch_signal_controller_sha" | grep -Eq '^[0-9a-f]{40}$' || return 1
  printf '%s\n' "$switch_signal_sha" | grep -Eq '^[0-9a-f]{40}$' || return 1
  for durable_switch_file in \
    /srv/project-snow/runtime/compose.env \
    "$active_file" \
    /srv/project-snow/releases/current-manifest.json \
    /srv/project-snow/releases/current-config.json \
    /srv/project-snow/releases/current; do
    [ -f "$durable_switch_file" ] && [ ! -L "$durable_switch_file" ] &&
      [ "$(stat -c %u:%g:%a:%h "$durable_switch_file" 2>/dev/null)" = 0:0:600:1 ] || return 1
  done
  cmp -s "/srv/project-snow/runtime/colours/$switch_signal_colour.compose.env" \
    /srv/project-snow/runtime/compose.env || return 1
  [ "$(cat "$active_file")" = "$switch_signal_colour" ] || return 1
  [ "$(jq -r '.commit_sha // empty' /srv/project-snow/releases/current-manifest.json)" = \
    "$switch_signal_sha" ] || return 1
  [ "$(jq -r '.colour // empty' /srv/project-snow/releases/current-config.json)" = \
    "$switch_signal_colour" ] &&
    [ "$(jq -r '.commit_sha // empty' /srv/project-snow/releases/current-config.json)" = \
      "$switch_signal_sha" ] || return 1
  durable_switch_extra=""
  read -r durable_switch_colour durable_switch_sha durable_switch_public \
    durable_switch_embedding durable_switch_extra < /srv/project-snow/releases/current || return 1
  [ "$durable_switch_colour" = "$switch_signal_colour" ] &&
    [ "$durable_switch_sha" = "$switch_signal_sha" ] &&
    [ "$durable_switch_public" = "$switch_signal_public" ] &&
    [ "$durable_switch_embedding" = "$switch_signal_embedding" ] &&
    [ -z "$durable_switch_extra" ] &&
    runner_matches_controller "$switch_signal_controller_sha" &&
    live_origin_edge_binding_matches_expected
}

switch_commit_is_durable() {
  switch_commit_matches_expected || return 1
  switch_runtime_identity="$(stat -c %d:%i /srv/project-snow/runtime/compose.env)" || return 1
  switch_active_identity="$(stat -c %d:%i "$active_file")" || return 1
  switch_manifest_identity="$(stat -c %d:%i /srv/project-snow/releases/current-manifest.json)" || return 1
  switch_config_identity="$(stat -c %d:%i /srv/project-snow/releases/current-config.json)" || return 1
  switch_current_identity="$(stat -c %d:%i /srv/project-snow/releases/current)" || return 1
  switch_live_origin_present="$durable_live_origin_present"
  switch_live_binding_identity=""
  switch_live_env_identity=""
  if [ "$switch_live_origin_present" -eq 1 ]; then
    switch_live_binding_identity="$(stat -c %d:%i "$durable_live_binding")" || return 1
    switch_live_env_identity="$(stat -c %d:%i "$durable_live_env")" || return 1
  fi
  for durable_switch_file in \
    /srv/project-snow/runtime/compose.env \
    "$active_file" \
    /srv/project-snow/releases/current-manifest.json \
    /srv/project-snow/releases/current-config.json \
    /srv/project-snow/releases/current; do
    fsync_release_path "$durable_switch_file" || return 1
  done
  if [ "$switch_live_origin_present" -eq 1 ]; then
    fsync_release_path "$durable_live_binding" || return 1
    fsync_release_path "$durable_live_env" || return 1
    fsync_release_path /srv/project-snow/runtime/origin-edge || return 1
  fi
  fsync_release_path /srv/project-snow/runtime || return 1
  fsync_release_path /srv/project-snow/releases || return 1
  [ "$(stat -c %d:%i /srv/project-snow/runtime/compose.env)" = "$switch_runtime_identity" ] &&
    [ "$(stat -c %d:%i "$active_file")" = "$switch_active_identity" ] &&
    [ "$(stat -c %d:%i /srv/project-snow/releases/current-manifest.json)" = "$switch_manifest_identity" ] &&
    [ "$(stat -c %d:%i /srv/project-snow/releases/current-config.json)" = "$switch_config_identity" ] &&
    [ "$(stat -c %d:%i /srv/project-snow/releases/current)" = "$switch_current_identity" ] || return 1
  if [ "$switch_live_origin_present" -eq 1 ]; then
    [ "$(stat -c %d:%i "$durable_live_binding")" = "$switch_live_binding_identity" ] &&
      [ "$(stat -c %d:%i "$durable_live_env")" = "$switch_live_env_identity" ] || return 1
  else
    [ ! -e /srv/project-snow/releases/live-origin-edge-config.json ] &&
      [ ! -L /srv/project-snow/releases/live-origin-edge-config.json ] || return 1
  fi
  switch_commit_matches_expected
}

stage_configuration_binding_matches_manifest() {
  stage_config_binding="$1"
  stage_config_manifest="$2"
  stage_config_colour="$3"
  stage_config_sha="$4"
  stage_config_root="/srv/project-snow/releases/configurations/$stage_config_sha"
  [ -f "$stage_config_binding" ] && [ ! -L "$stage_config_binding" ] &&
    [ "$(stat -c %u:%g:%a:%h "$stage_config_binding" 2>/dev/null)" = 0:0:600:1 ] || return 1
  jq -e --arg colour "$stage_config_colour" --arg sha "$stage_config_sha" \
    --arg root "$stage_config_root" '
      type == "object" and
      .schema_version == "project-snow-config-snapshot-1" and
      .colour == $colour and .commit_sha == $sha and .root == $root and
      (.configuration_sha256 | type == "object" and length > 0) and
      all(.configuration_sha256 | keys[];
        test("^[0-9A-Za-z._/-]+$") and
        (startswith("/") | not) and
        (split("/") | all(. != "" and . != "." and . != ".."))) and
      all(.configuration_sha256[];
        type == "string" and test("^[0-9a-f]{64}$"))
    ' "$stage_config_binding" >/dev/null || return 1
  stage_binding_hashes="$(jq -cS '.configuration_sha256' "$stage_config_binding")" || return 1
  stage_manifest_hashes="$(jq -cS '.configuration_sha256' "$stage_config_manifest")" || return 1
  [ "$stage_binding_hashes" = "$stage_manifest_hashes" ] || return 1
  [ -d "$stage_config_root" ] && [ ! -L "$stage_config_root" ] || return 1
  stage_config_paths="$(jq -r '.configuration_sha256 | keys[]' "$stage_config_binding")" || return 1
  stage_expected_files="$(printf '%s\n' "$stage_config_paths" | LC_ALL=C sort)" || return 1
  stage_found_files="$(CDPATH= cd -- "$stage_config_root" &&
    find . -mindepth 1 -type f -printf '%P\n')" || return 1
  stage_found_files="$(printf '%s\n' "$stage_found_files" | LC_ALL=C sort)" || return 1
  [ "$stage_found_files" = "$stage_expected_files" ] || return 1
  stage_unexpected_type="$(find "$stage_config_root" -mindepth 1 \
    ! -type f ! -type d -print -quit)" || return 1
  [ -z "$stage_unexpected_type" ] || return 1
  stage_expected_dirs='.'
  for stage_config_path in $stage_config_paths; do
    stage_config_parent="$(dirname "$stage_config_path")" || return 1
    while [ "$stage_config_parent" != . ]; do
      stage_expected_dirs="$stage_expected_dirs
$stage_config_parent"
      stage_config_parent="$(dirname "$stage_config_parent")" || return 1
    done
  done
  stage_expected_dirs="$(printf '%s\n' "$stage_expected_dirs" |
    awk 'NF' | LC_ALL=C sort -u)" || return 1
  stage_found_dirs="$(CDPATH= cd -- "$stage_config_root" &&
    { printf '%s\n' .; find . -mindepth 1 -type d -printf '%P\n'; })" || return 1
  stage_found_dirs="$(printf '%s\n' "$stage_found_dirs" |
    awk 'NF' | LC_ALL=C sort -u)" || return 1
  [ "$stage_found_dirs" = "$stage_expected_dirs" ] || return 1
  stage_config_file_state=''
  for stage_config_path in $stage_config_paths; do
    stage_config_file="$stage_config_root/$stage_config_path"
    stage_config_metadata="$(stat -c %d:%i:%u:%g:%a:%h "$stage_config_file" 2>/dev/null)" || return 1
    case "$stage_config_metadata" in *:0:0:444:1) ;; *) return 1 ;; esac
    stage_config_digest="$(sha256sum "$stage_config_file" | awk '{print $1}')" || return 1
    stage_config_expected="$(jq -r --arg path "$stage_config_path" \
      '.configuration_sha256[$path]' "$stage_config_binding")" || return 1
    [ "$stage_config_digest" = "$stage_config_expected" ] || return 1
    stage_config_file_state="$stage_config_file_state$stage_config_path|$stage_config_metadata|$stage_config_digest;"
  done
  stage_config_dir_state=''
  for stage_config_dir in $stage_expected_dirs; do
    if [ "$stage_config_dir" = . ]; then
      stage_config_directory="$stage_config_root"
    else
      stage_config_directory="$stage_config_root/$stage_config_dir"
    fi
    stage_config_metadata="$(stat -c %d:%i:%u:%g:%a "$stage_config_directory" 2>/dev/null)" || return 1
    case "$stage_config_metadata" in *:0:0:555) ;; *) return 1 ;; esac
    stage_config_dir_state="$stage_config_dir_state$stage_config_dir|$stage_config_metadata;"
  done
}

stage_configuration_binding_is_durable() {
  durable_config_binding="$1"
  durable_config_manifest="$2"
  durable_config_colour="$3"
  durable_config_sha="$4"
  stage_configuration_binding_matches_manifest "$durable_config_binding" \
    "$durable_config_manifest" "$durable_config_colour" "$durable_config_sha" || return 1
  durable_config_binding_identity="$(stat -c %d:%i "$durable_config_binding")" || return 1
  durable_config_file_state="$stage_config_file_state"
  durable_config_dir_state="$stage_config_dir_state"
  fsync_release_path "$durable_config_binding" || return 1
  for durable_config_path in $stage_config_paths; do
    fsync_release_path "$stage_config_root/$durable_config_path" || return 1
  done
  durable_config_dirs="$(find "$stage_config_root" -depth -type d -print)" || return 1
  for durable_config_dir in $durable_config_dirs; do
    fsync_release_path "$durable_config_dir" || return 1
  done
  fsync_release_path /srv/project-snow/releases/configurations || return 1
  fsync_release_path "$colour_root" || return 1
  [ "$(stat -c %d:%i "$durable_config_binding")" = "$durable_config_binding_identity" ] || return 1
  stage_configuration_binding_matches_manifest "$durable_config_binding" \
    "$durable_config_manifest" "$durable_config_colour" "$durable_config_sha" || return 1
  [ "$stage_config_file_state" = "$durable_config_file_state" ] &&
    [ "$stage_config_dir_state" = "$durable_config_dir_state" ]
}

stage_commit_is_durable() {
  durable_manifest="$1"
  durable_colour="$2"
  durable_sha="$3"
  durable_public="$4"
  durable_embedding="$5"
  durable_nonce="$6"
  durable_marker="$colour_root/$durable_colour"
  durable_receipt="$colour_root/$durable_colour-stage-receipt"
  # A child killed after rename but before its own directory fsync can leave a
  # visible marker.  The root runner must make that entry durable itself before
  # accepting a non-zero child result as an exact committed stage.
  fsync_release_path "$colour_root" || return 1
  durable_runner_sha="$(jq -r '.release_control_sha256["ops/project-snow-release"] // empty' \
    "$durable_manifest")" || return 1
  printf '%s\n' "$durable_runner_sha" | grep -Eq '^[0-9a-f]{64}$' || return 1
  printf '%s\n' "$durable_nonce" | grep -Eq '^[0-9a-f]{64}$' || return 1
  [ "$(git -C "$repo" rev-parse HEAD 2>/dev/null)" = "$durable_sha" ] &&
    [ -f "$runner_path" ] && [ ! -L "$runner_path" ] &&
    [ "$(stat -c %u:%g:%a:%h "$runner_path" 2>/dev/null || true)" = 0:0:755:1 ] &&
    [ "$(sha256sum "$runner_path" | awk '{print $1}')" = "$durable_runner_sha" ] &&
    [ -f "$durable_marker" ] && [ ! -L "$durable_marker" ] &&
    [ "$(stat -c %u:%g:%a:%h "$durable_marker" 2>/dev/null || true)" = 0:0:600:1 ] &&
    [ "$(wc -l < "$durable_marker")" -eq 1 ] &&
    [ -f "$durable_receipt" ] && [ ! -L "$durable_receipt" ] &&
    [ "$(stat -c %u:%g:%a:%h "$durable_receipt" 2>/dev/null || true)" = 0:0:600:1 ] &&
    [ "$(wc -l < "$durable_receipt")" -eq 1 ] || return 1
  durable_extra=""
  read -r marker_colour marker_sha marker_public marker_embedding durable_extra < "$durable_marker" || return 1
  receipt_extra=""
  read -r receipt_schema receipt_nonce receipt_colour receipt_sha \
    receipt_public receipt_embedding receipt_extra < "$durable_receipt" || return 1
  [ "$marker_colour" = "$durable_colour" ] && [ "$marker_sha" = "$durable_sha" ] &&
    [ "$marker_public" = "$durable_public" ] &&
    [ "$marker_embedding" = "$durable_embedding" ] && [ -z "$durable_extra" ] &&
    [ "$receipt_schema" = project-snow-stage-receipt-1 ] &&
    [ "$receipt_nonce" = "$durable_nonce" ] &&
    [ "$receipt_colour" = "$durable_colour" ] && [ "$receipt_sha" = "$durable_sha" ] &&
    [ "$receipt_public" = "$durable_public" ] &&
    [ "$receipt_embedding" = "$durable_embedding" ] && [ -z "$receipt_extra" ] &&
    stage_configuration_binding_is_durable "$colour_root/$durable_colour-config.json" \
      "$durable_manifest" "$durable_colour" "$durable_sha"
}

copy_inbox_manifest() {
  manifest_source="$1"
  manifest_destination="$2"
  deploy_uid="$(id -u deploy)"
  python3 - "$manifest_source" "$manifest_destination" "$deploy_uid" <<'PY'
import json
import os
import stat
import sys

source, destination, expected_uid = sys.argv[1], sys.argv[2], int(sys.argv[3])
flags = os.O_RDONLY | os.O_CLOEXEC
if hasattr(os, "O_NOFOLLOW"):
    flags |= os.O_NOFOLLOW
descriptor = os.open(source, flags)
try:
    metadata = os.fstat(descriptor)
    if not stat.S_ISREG(metadata.st_mode):
        raise SystemExit("release manifest inbox entry is not a regular file")
    if metadata.st_uid != expected_uid or metadata.st_nlink != 1:
        raise SystemExit("release manifest inbox ownership/link count is invalid")
    if metadata.st_size < 2 or metadata.st_size > 131072:
        raise SystemExit("release manifest inbox entry has an invalid size")
    payload = bytearray()
    while True:
        chunk = os.read(descriptor, 65536)
        if not chunk:
            break
        payload.extend(chunk)
finally:
    os.close(descriptor)
json.loads(payload.decode("utf-8"))
with open(destination, "wb") as output:
    output.write(payload)
os.chmod(destination, 0o600)
PY
}

validate_release_manifest() {
  manifest_path="$1"
  commit_sha="$2"
  jq -e \
    --arg sha "$commit_sha" \
    --arg public_image "$expected_public_image" \
    --arg embedding_image "$expected_embedding_image" '
      .schema_version == "project-snow-release-1" and
      .commit_sha == $sha and
      .application.image == $public_image and
      .embedding.image == $embedding_image and
      (.application.digest | type == "string" and test("^sha256:[0-9a-f]{64}$")) and
      (.embedding.digest | type == "string" and test("^sha256:[0-9a-f]{64}$")) and
      .release_artifacts.data.version == .data_version and
      .release_artifacts.avatar.version == .media_version and
      .release_artifacts.sticker.version == .sticker_version and
      (.release_artifacts.data.manifest_sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
      (.release_artifacts.avatar.manifest_sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
      (.release_artifacts.avatar.checksums_sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
      (.release_artifacts.sticker.manifest_sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
      (.release_artifacts.sticker.checksums_sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
      (.release_control_sha256 | type == "object" and length == 2) and
      (.release_control_sha256["ops/project-snow-release"] |
        type == "string" and test("^[0-9a-f]{64}$")) and
      (.release_control_sha256["ops/project-snow-release.sudoers"] |
        type == "string" and test("^[0-9a-f]{64}$")) and
      (.direct_origin_tls | type == "object" and length == 5) and
      .direct_origin_tls.schema_version == "project-snow-origin-tls-1" and
      .direct_origin_tls.hostname == "snow.xiaob.dev" and
      (.direct_origin_tls.bundle_sha256 |
        type == "string" and test("^[0-9a-f]{64}$")) and
      (.direct_origin_tls.origin_certificate_sha256 |
        type == "string" and test("^[0-9a-f]{64}$")) and
      (.direct_origin_tls.aop_ca_sha256 |
        type == "string" and test("^[0-9a-f]{64}$"))
    ' "$manifest_path" >/dev/null || {
      echo 'The uploaded release manifest has an invalid identity.' >&2
      return 1
    }

  public_digest="$(jq -r '.application.digest' "$manifest_path")" || return 1
  embedding_digest="$(jq -r '.embedding.digest' "$manifest_path")" || return 1
  regenerated_manifest="$(mktemp /run/project-snow-release.expected.XXXXXX.json)" || return 1
  cleanup_paths="$cleanup_paths $regenerated_manifest"
  uploaded_normalized="$(mktemp /run/project-snow-release.uploaded.XXXXXX.json)" || return 1
  cleanup_paths="$cleanup_paths $uploaded_normalized"
  expected_normalized="$(mktemp /run/project-snow-release.normalized.XXXXXX.json)" || return 1
  cleanup_paths="$cleanup_paths $expected_normalized"
  python3 "$app_root/scripts/release_manifest.py" \
    --sha "$commit_sha" \
    --public-image "$expected_public_image" \
    --public-digest "$public_digest" \
    --embedding-image "$expected_embedding_image" \
    --embedding-digest "$embedding_digest" \
    --app-root "$app_root" \
    --output "$regenerated_manifest" >/dev/null || return 1
  jq -S 'del(.generated_at)' "$manifest_path" > "$uploaded_normalized" || return 1
  jq -S 'del(.generated_at)' "$regenerated_manifest" > "$expected_normalized" || return 1
  cmp -s "$uploaded_normalized" "$expected_normalized" || {
    echo 'The uploaded manifest does not match the trusted main checkout.' >&2
    return 1
  }

  public_tag_digest="$(docker buildx imagetools inspect \
    "$expected_public_image:$commit_sha" 2>/dev/null | awk '/^Digest:/ {print $2; exit}')"
  embedding_tag_digest="$(docker buildx imagetools inspect \
    "$expected_embedding_image:$commit_sha" 2>/dev/null | awk '/^Digest:/ {print $2; exit}')"
  [ "$public_tag_digest" = "$public_digest" ] || {
    echo 'The public image digest is not the digest tagged for this main SHA.' >&2
    return 1
  }
  [ "$embedding_tag_digest" = "$embedding_digest" ] || {
    echo 'The embedding image digest is not the digest tagged for this main SHA.' >&2
    return 1
  }
}

install_manifest_releases() {
  manifest_path="$1"
  deploy_uid="$(id -u deploy)"
  data_version="$(jq -r '.data_version // empty' "$manifest_path")"
  avatar_version="$(jq -r '.media_version // empty' "$manifest_path")"
  sticker_version="$(jq -r '.sticker_version // empty' "$manifest_path")"
  install_manifest_release \
    data "$data_version" /srv/project-snow/data/releases \
    "$(jq -r '.release_artifacts.data.manifest_sha256 // empty' "$manifest_path")" "" \
    "$deploy_uid" || return 1
  install_manifest_release \
    avatar "$avatar_version" /srv/project-snow/media/releases \
    "$(jq -r '.release_artifacts.avatar.manifest_sha256 // empty' "$manifest_path")" \
    "$(jq -r '.release_artifacts.avatar.checksums_sha256 // empty' "$manifest_path")" \
    "$deploy_uid" || return 1
  install_manifest_release \
    sticker "$sticker_version" /srv/project-snow/media/stickers/releases \
    "$(jq -r '.release_artifacts.sticker.manifest_sha256 // empty' "$manifest_path")" \
    "$(jq -r '.release_artifacts.sticker.checksums_sha256 // empty' "$manifest_path")" \
    "$deploy_uid" || return 1
}

install_manifest_release() {
  release_kind="$1"
  release_version="$2"
  release_destination="$3"
  release_manifest_sha256="$4"
  release_checksums_sha256="$5"
  deploy_uid="$6"
  case "$release_kind" in data|avatar|sticker) ;; *) return 1 ;; esac
  case "$release_version" in
    *[!0-9A-Za-z._-]*|'')
      echo "Manifest contains an unsafe $release_kind release version." >&2
      return 1
      ;;
  esac
  printf '%s\n' "$release_manifest_sha256" | grep -Eq '^[0-9a-f]{64}$' || return 1
  if [ "$release_kind" = data ]; then
    [ -z "$release_checksums_sha256" ] || return 1
  else
    printf '%s\n' "$release_checksums_sha256" | grep -Eq '^[0-9a-f]{64}$' || return 1
  fi
  install -o root -g root -m 0755 -d "$release_destination" || return 1
  release_archive="$inbox/$release_kind-$release_version.tar"
  set -- python3 "$app_root/scripts/install_release_archive.py" \
    --kind "$release_kind" \
    --version "$release_version" \
    --destination-root "$release_destination" \
    --expected-owner-uid "$deploy_uid" \
    --manifest-sha256 "$release_manifest_sha256"
  if [ -n "$release_checksums_sha256" ]; then
    set -- "$@" --checksums-sha256 "$release_checksums_sha256"
  fi
  if [ -e "$release_archive" ] || [ -L "$release_archive" ]; then
    set -- "$@" --archive "$release_archive"
  fi
  "$@"
}

run_stage() {
  manifest_source="$inbox/release-$requested_sha.json"
  [ -d "$inbox" ] && [ ! -L "$inbox" ] || {
    echo 'The release inbox is missing.' >&2
    exit 66
  }
  [ "$(stat -c %U "$inbox")" = deploy ] && [ "$(stat -c %a "$inbox")" = 700 ] || {
    echo 'The release inbox must be deploy-owned with mode 0700.' >&2
    exit 66
  }
  manifest_copy="$(mktemp /run/project-snow-release.manifest.XXXXXX.json)"
  cleanup_paths="$cleanup_paths $manifest_copy"
  copy_inbox_manifest "$manifest_source" "$manifest_copy"

  fetch_main
  previous_controller="$(current_controller_sha)"
  previous_runner_sha256="$(sha256sum "$runner_path" | awk '{print $1}')"
  printf '%s\n' "$previous_runner_sha256" | grep -Eq '^[0-9a-f]{64}$' || {
    echo 'Installed release runner has no valid predecessor digest.' >&2
    exit 71
  }
  previous_runner_controller="$(resolve_installed_runner_controller \
    "$requested_sha" "$previous_runner_sha256" "$previous_controller")" || {
      echo 'Installed release runner has no trusted predecessor controller.' >&2
      exit 71
    }
  stage_signal_restore_controller="$previous_runner_controller"
  checkout_controller "$requested_sha" || {
    checkout_controller "$previous_runner_controller" || true
    exit 71
  }
  if ! validate_release_manifest "$manifest_copy" "$requested_sha" ||
     ! install_manifest_releases "$manifest_copy"; then
    checkout_controller "$previous_runner_controller" || true
    exit 71
  fi
  public_image="$expected_public_image@$(jq -r '.application.digest' "$manifest_copy")"
  embedding_image="$expected_embedding_image@$(jq -r '.embedding.digest' "$manifest_copy")"
  stage_attempt_nonce="$(python3 -c 'import secrets; print(secrets.token_hex(32))')" || {
    checkout_controller "$previous_runner_controller" || true
    exit 71
  }
  printf '%s\n' "$stage_attempt_nonce" | grep -Eq '^[0-9a-f]{64}$' || {
    checkout_controller "$previous_runner_controller" || true
    exit 71
  }
  stage_signal_manifest="$manifest_copy"
  stage_signal_colour="$colour"
  stage_signal_sha="$requested_sha"
  stage_signal_public="$public_image"
  stage_signal_embedding="$embedding_image"
  stage_signal_nonce="$stage_attempt_nonce"
  stage_signal_can_ack=1
  release_signal_child_operation=stage
  stage_signal_child_expected=1
  (
    cd "$app_root" || exit 70
    exec /usr/bin/env -i \
      HOME=/root USER=root LOGNAME=root \
      PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
      PROJECT_SNOW_RELEASE_MANIFEST="$manifest_copy" \
      PROJECT_SNOW_RELEASE_PREVIOUS_CONTROLLER_SHA="$previous_runner_controller" \
      PROJECT_SNOW_RELEASE_PREVIOUS_RUNNER_SHA256="$previous_runner_sha256" \
      PROJECT_SNOW_RELEASE_ATTEMPT_NONCE="$stage_attempt_nonce" \
      PUBLIC_API_IMAGE="$public_image" \
      EMBEDDING_IMAGE="$embedding_image" \
      ./ops/deploy.sh "$colour" "$requested_sha"
  ) &
  stage_signal_child_pid=$!
  stage_child_status=0
  wait "$stage_signal_child_pid" || stage_child_status=$?
  stage_signal_child_pid=""
  stage_signal_child_expected=0
  if [ "$stage_child_status" -ne 0 ]; then
    if stage_commit_is_durable "$manifest_copy" "$colour" "$requested_sha" \
      "$public_image" "$embedding_image" "$stage_attempt_nonce"; then
      echo 'Release staging exited after its exact durable commit; retaining the target controller.' >&2
    else
      checkout_controller "$previous_runner_controller" || true
      echo 'Release staging failed; the installed runner controller was restored.' >&2
      exit 72
    fi
  fi
  rm -f -- "$manifest_source"
  for installed_coordinate in \
    "data|$(jq -r '.data_version' "$manifest_copy")" \
    "avatar|$(jq -r '.media_version' "$manifest_copy")" \
    "sticker|$(jq -r '.sticker_version' "$manifest_copy")"; do
    rm -f -- "$inbox/${installed_coordinate%%|*}-${installed_coordinate#*|}.tar"
  done
  printf '%s\n' "Staged $colour at $requested_sha through the root-owned release runner."
}

run_switch() {
  switch_operation="$1"
  fetch_main
  controller_sha="$(current_controller_sha)"
  runner_matches_controller "$controller_sha" || {
    echo 'Installed release runner is not bound to the checked-out controller; repeat exact stage before switching traffic.' >&2
    exit 78
  }
  marker="$colour_root/$colour"
  [ -r "$marker" ] && [ ! -L "$marker" ] || {
    echo "No staged release marker exists for $colour." >&2
    exit 66
  }
  read -r marker_colour marker_sha marker_public marker_embedding < "$marker"
  [ "$marker_colour" = "$colour" ] && [ "$marker_sha" = "$requested_sha" ] || {
    echo 'The requested release does not match the staged colour marker.' >&2
    exit 67
  }
  printf '%s\n' "$controller_sha" | grep -Eq '^[0-9a-f]{40}$' || exit 67
  switch_signal_controller_sha="$controller_sha"
  switch_signal_colour="$colour"
  switch_signal_sha="$requested_sha"
  switch_signal_public="$marker_public"
  switch_signal_embedding="$marker_embedding"
  switch_signal_can_ack=1
  release_signal_child_operation=switch
  stage_signal_child_expected=1
  (
    cd "$app_root" || exit 70
    if [ "$switch_operation" = promote ]; then
      exec ./ops/promote.sh "$colour" "$requested_sha"
    fi
    # This flag cannot be inherited or supplied by the SSH caller because the
    # runner re-executes under an empty environment.  The rollback path uses it
    # only to require an unauthenticated Cloudflare Access gate before a
    # compatibility smoke against a legacy edge snapshot.
    exec /usr/bin/env PROJECT_SNOW_ROLLBACK_MODE=1 \
      ./ops/rollback.sh "$colour" "$requested_sha"
  ) &
  stage_signal_child_pid=$!
  switch_child_status=0
  wait "$stage_signal_child_pid" || switch_child_status=$?
  stage_signal_child_pid=""
  stage_signal_child_expected=0
  if [ "$switch_child_status" -eq 0 ]; then
    switch_commit_is_durable || return 74
    return 0
  fi
  return "$switch_child_status"
}

verified_version_array() {
  release_kind="$1"
  versions_root="$2"
  artifact_index="$app_root/config/public_release_artifacts.json"
  if [ ! -d "$versions_root" ] || [ -L "$versions_root" ] ||
     [ ! -r "$artifact_index" ] || [ -L "$artifact_index" ]; then
    printf '%s\n' '[]'
    return
  fi
  release_version="$(jq -r --arg kind "$release_kind" '.artifacts[$kind].version // empty' "$artifact_index")"
  release_manifest_sha256="$(jq -r --arg kind "$release_kind" '.artifacts[$kind].manifest_sha256 // empty' "$artifact_index")"
  release_checksums_sha256="$(jq -r --arg kind "$release_kind" '.artifacts[$kind].checksums_sha256 // empty' "$artifact_index")"
  set -- python3 "$app_root/scripts/install_release_archive.py" \
    --kind "$release_kind" \
    --version "$release_version" \
    --destination-root "$versions_root" \
    --expected-owner-uid "$(id -u deploy)" \
    --manifest-sha256 "$release_manifest_sha256"
  if [ -n "$release_checksums_sha256" ]; then
    set -- "$@" --checksums-sha256 "$release_checksums_sha256"
  fi
  if "$@" >/dev/null 2>&1; then
    jq -n --arg version "$release_version" '[$version]'
  else
    printf '%s\n' '[]'
  fi
}

root_authorized_keys_safe() {
  root_ssh_directory=/root/.ssh
  root_authorized_keys="$root_ssh_directory/authorized_keys"
  [ -d "$root_ssh_directory" ] && [ ! -L "$root_ssh_directory" ] &&
    [ "$(stat -c %u:%g "$root_ssh_directory" 2>/dev/null)" = 0:0 ] &&
    [ -z "$(find "$root_ssh_directory" -maxdepth 0 -perm /022 -print -quit 2>/dev/null)" ] &&
    [ -s "$root_authorized_keys" ] && [ -f "$root_authorized_keys" ] &&
    [ ! -L "$root_authorized_keys" ] &&
    [ "$(stat -c %u:%g:%h "$root_authorized_keys" 2>/dev/null)" = 0:0:1 ] &&
    [ -z "$(find "$root_authorized_keys" -maxdepth 0 -perm /022 -print -quit 2>/dev/null)" ]
}

sshd_allowed_users_are_exact() {
  [ "$(printf '%s\n' "$1" | sed -n 's/^allowusers //p' | LC_ALL=C sort | tr '\n' ' ')" = 'deploy root ' ]
}

sshd_policy_active() {
  root_authorized_keys_safe || return 1
  effective_deploy="$(sshd -T -C user=deploy,host=localhost,addr=127.0.0.1 2>/dev/null)" || return 1
  for required_setting in \
    'passwordauthentication no' \
    'kbdinteractiveauthentication no' \
    'permitrootlogin without-password' \
    'pubkeyauthentication yes' \
    'maxauthtries 3' \
    'maxsessions 4' \
    'allowtcpforwarding yes' \
    'x11forwarding no'; do
    printf '%s\n' "$effective_deploy" | grep -Fxq "$required_setting" || return 1
  done
  sshd_allowed_users_are_exact "$effective_deploy" || return 1
  [ "$(printf '%s\n' "$effective_deploy" | sed -n 's/^port //p')" = 43556 ] || return 1
  effective_root="$(sshd -T -C user=root,host=localhost,addr=127.0.0.1 2>/dev/null)" || return 1
  printf '%s\n' "$effective_root" | grep -Fxq 'permitrootlogin without-password' &&
    printf '%s\n' "$effective_root" | grep -Fxq 'pubkeyauthentication yes' &&
    printf '%s\n' "$effective_root" | grep -Fxq 'passwordauthentication no' &&
    printf '%s\n' "$effective_root" | grep -Fxq 'kbdinteractiveauthentication no' &&
    printf '%s\n' "$effective_root" | grep -Fxq 'maxsessions 4' &&
    printf '%s\n' "$effective_root" | grep -Fxq 'x11forwarding no' &&
    sshd_allowed_users_are_exact "$effective_root"
}

ufw_policy_active() {
  command -v ufw >/dev/null 2>&1 &&
    ufw status 2>/dev/null | grep -Fxq 'Status: active'
}

fail2ban_sshd_active() {
  systemctl is-active --quiet fail2ban 2>/dev/null &&
    fail2ban-client status sshd >/dev/null 2>&1
}

deploy_lacks_docker_group() {
  deploy_groups="$(id -nG deploy 2>/dev/null)" || return 1
  case " $deploy_groups " in
    *' docker '*) return 1 ;;
    *) return 0 ;;
  esac
}

deploy_cannot_access_docker() {
  ! runuser -u deploy -- docker info >/dev/null 2>&1
}

deploy_processes_lack_docker_socket_group() {
  [ -S /var/run/docker.sock ] || return 1
  deploy_uid="$(id -u deploy 2>/dev/null)" || return 1
  docker_socket_gid="$(stat -Lc %g /var/run/docker.sock 2>/dev/null)" || return 1
  for process_status in /proc/[0-9]*/status; do
    [ -r "$process_status" ] || continue
    process_uid="$(sed -n 's/^Uid:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$process_status" 2>/dev/null || true)"
    [ "$process_uid" = "$deploy_uid" ] || continue
    if sed -n 's/^Groups:[[:space:]]*//p' "$process_status" 2>/dev/null |
       tr ' ' '\n' | grep -Fxq "$docker_socket_gid"; then
      return 1
    fi
  done
}

host_safety_preflight_active() {
  sshd_policy_active &&
    ufw_policy_active &&
    fail2ban_sshd_active &&
    deploy_lacks_docker_group &&
    deploy_cannot_access_docker &&
    deploy_processes_lack_docker_socket_group
}

require_host_safety_preflight() {
  host_safety_preflight_active && return 0
  echo 'Host safety preflight failed.' >&2
  return 1
}

acquire_release_lock() {
  install -o root -g root -m 0755 -d /run/lock
  exec 9>"$release_lock"
  if ! flock -n 9; then
    echo 'Another Project Snow release operation is already running.' >&2
    exit 75
  fi
}

run_status() {
  require_root_controlled_repo
  controller_sha="$(git -C "$repo" rev-parse --verify HEAD 2>/dev/null || true)"
  active_colour=""
  if [ -r "$active_file" ] && [ ! -L "$active_file" ]; then
    active_colour="$(cat "$active_file")"
  fi
  case "$active_colour" in blue|green) ;; *) active_colour=invalid ;; esac
  docker_group=false
  if ! deploy_lacks_docker_group; then
    docker_group=true
  fi
  docker_access=false
  if ! deploy_cannot_access_docker; then
    docker_access=true
  fi
  deploy_process_docker_group=false
  if ! deploy_processes_lack_docker_socket_group; then
    deploy_process_docker_group=true
  fi
  ufw_active=false
  if ufw_policy_active; then
    ufw_active=true
  fi
  fail2ban_active=false
  if fail2ban_sshd_active; then
    fail2ban_active=true
  fi
  sshd_hardened=false
  if sshd_policy_active; then
    sshd_hardened=true
  fi
  host_safety_preflight=false
  if host_safety_preflight_active; then
    host_safety_preflight=true
  fi
  release_runner_sha256=""
  if [ -f "$runner_path" ] && [ ! -L "$runner_path" ] &&
     [ "$(stat -c %u:%g:%a:%h "$runner_path" 2>/dev/null || true)" = 0:0:755:1 ]; then
    release_runner_sha256="$(sha256sum "$runner_path" | awk '{print $1}')"
  fi
  runner_controller_binding=false
  if runner_matches_controller "$controller_sha"; then
    runner_controller_binding=true
  fi
  data_versions="$(verified_version_array data /srv/project-snow/data/releases)"
  avatar_versions="$(verified_version_array avatar /srv/project-snow/media/releases)"
  sticker_versions="$(verified_version_array sticker /srv/project-snow/media/stickers/releases)"
  jq -n \
    --arg controller_sha "$controller_sha" \
    --arg active_colour "$active_colour" \
    --arg release_runner_sha256 "$release_runner_sha256" \
    --argjson runner_controller_binding "$runner_controller_binding" \
    --argjson deploy_has_docker_group "$docker_group" \
    --argjson deploy_can_access_docker "$docker_access" \
    --argjson deploy_process_has_docker_socket_group "$deploy_process_docker_group" \
    --argjson ufw_active "$ufw_active" \
    --argjson fail2ban_active "$fail2ban_active" \
    --argjson sshd_hardened "$sshd_hardened" \
    --argjson host_safety_preflight "$host_safety_preflight" \
    --argjson data_versions "$data_versions" \
    --argjson avatar_versions "$avatar_versions" \
    --argjson sticker_versions "$sticker_versions" \
    '{controller_sha: $controller_sha, active_colour: $active_colour,
      release_runner_sha256: $release_runner_sha256,
      runner_controller_binding: $runner_controller_binding,
      deploy_has_docker_group: $deploy_has_docker_group,
      deploy_can_access_docker: $deploy_can_access_docker,
      deploy_process_has_docker_socket_group: $deploy_process_has_docker_socket_group,
      ufw_active: $ufw_active,
      fail2ban_active: $fail2ban_active,
      sshd_hardened: $sshd_hardened,
      host_safety_preflight: $host_safety_preflight,
      installed_data_versions: $data_versions,
      installed_avatar_versions: $avatar_versions,
      installed_sticker_versions: $sticker_versions}'
}

run_mutating_operation() {
  require_host_safety_preflight || exit 78
  acquire_release_lock
  case "$operation" in
    stage) run_stage ;;
    promote) run_switch promote ;;
    rollback) run_switch rollback ;;
  esac
}

case "$operation" in
  status) run_status ;;
  stage|promote|rollback) run_mutating_operation ;;
esac
