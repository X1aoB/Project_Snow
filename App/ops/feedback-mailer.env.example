# Non-secret settings for the isolated receipt-only feedback worker.
# Production requires this exact five-key shape at
# /etc/project-snow/feedback-mailer.env with root:root ownership and mode 0600.
PUBLIC_FEEDBACK_EMAIL_TO=admin@xiaob.dev
# Leave the following three values empty together to keep receipt email
# disabled. Configure all three together when SMTP credentials are installed.
PUBLIC_FEEDBACK_EMAIL_FROM=
PUBLIC_FEEDBACK_SMTP_HOST=
PUBLIC_FEEDBACK_SMTP_PORT=465
PUBLIC_FEEDBACK_SMTP_USERNAME=
