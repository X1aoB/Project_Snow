# Resolve every tag to an immutable linux/amd64 digest before deployment.
PUBLIC_ENV_FILE=/etc/project-snow/public.env
CADDY_IMAGE=caddy:2-alpine@sha256:replace-with-64-hex-digest
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest@sha256:replace-with-64-hex-digest
POSTGRES_IMAGE=postgres:16-bookworm@sha256:replace-with-64-hex-digest
QDRANT_IMAGE=qdrant/qdrant:latest@sha256:replace-with-64-hex-digest
NEO4J_IMAGE=neo4j:5-community@sha256:replace-with-64-hex-digest
EGRESS_PROXY_IMAGE=ubuntu/squid:latest@sha256:replace-with-64-hex-digest
