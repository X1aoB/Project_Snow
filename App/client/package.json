{
  "name": "project-snow-desktop",
  "version": "0.5.0",
  "private": true,
  "author": "Project Snow",
  "description": "Local Windows v0.5.0 dual-entry preview client for Project Snow",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron smoke.js",
    "package:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^36.3.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.projectsnow.mvp",
    "productName": "Project Snow Preview",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "files": [
      "main.js",
      "preload.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Project-Snow-Preview-${version}.exe"
    }
  }
}
