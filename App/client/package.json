{
  "name": "project-snow-desktop",
  "version": "0.5.0",
  "private": true,
  "author": "小吉终端",
  "description": "小吉终端本地 Windows 预览客户端",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron smoke.js",
    "package:win": "electron-builder --win portable",
    "smoke:brand": "electron brand-smoke.js"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.projectsnow.mvp",
    "productName": "小吉终端",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "assets/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Xiaoji-Terminal-Preview-${version}.exe",
      "icon": "assets/xiaoji-icon.ico"
    }
  }
}
