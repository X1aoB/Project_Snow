# API
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Stage gate: leave false until B and C validation is explicitly accepted.
CHAT_ENABLED=false

# Internal first-pass dialogue harness. Keep false while inspecting dry-run
# prompts; enable only for local MVP calls. This does not unlock /api/v1/chat.
MVP_CHAT_ENABLED=false
MVP_CHAT_PROVIDER=openai-compatible
MVP_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MVP_CHAT_API_KEY=
MVP_CHAT_MODEL=qwen3.7-max
MVP_CHAT_TIMEOUT_SECONDS=120
MVP_CHAT_TIMEZONE=Asia/Shanghai
MVP_CHAT_ENABLE_THINKING=false
# Assistant-only visible work summaries are safe execution notes, not hidden
# chain-of-thought.  This cap allows detailed answers while remaining bounded.
MVP_CHAT_ASSISTANT_MAX_TOKENS=8192
MVP_CHAT_WEB_TIMEOUT_SECONDS=15
MVP_CHAT_WEB_MAX_RESULTS=5
# Time-sensitive assistant questions may read this many public result pages
# after multi-query search. Values are bounded to 0-3 by the backend.
MVP_CHAT_WEB_RESEARCH_PAGE_LIMIT=2
# Public daily OHLCV requests use a separate short timeout.
MVP_CHAT_MARKET_TIMEOUT_SECONDS=15
# Optional stricter DNS-level private-address blocking. Some corporate
# resolvers map public domains to proxy/documentation addresses, so leave false
# for the default local test setup.
MVP_CHAT_BLOCK_PRIVATE_DNS=false
# Keep assistant answers focused while allowing immersive dialogue a little
# more variation.  The generic value is a fallback; per-mode values win.
MVP_CHAT_TEMPERATURE=
MVP_CHAT_IMMERSIVE_TEMPERATURE=0.45
MVP_CHAT_ASSISTANT_TEMPERATURE=0.20
MVP_CHAT_MAX_ATTEMPTS=2
MVP_CHAT_RETRY_BACKOFF_SECONDS=1.5

# Local Chinese embedding model. It is downloaded by sentence-transformers on first vector build.
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_BATCH_SIZE=16
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=project_snow_documents

# Optional only for internal candidate extraction. Never commit a real key.
RELATION_CANDIDATE_PROVIDER=disabled
# Official Alibaba Cloud DashScope endpoint. These take precedence when both
# DashScope and generic compatible variables are configured.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
# Generic compatible endpoint fallback.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
# Structured extraction needs JSON output, not exposed reasoning. Set false only to diagnose a provider.
RELATION_CANDIDATE_DISABLE_THINKING=true
# Production extraction retries transient transport failures. Values are capped at 5 attempts and 30 seconds.
RELATION_CANDIDATE_MAX_ATTEMPTS=3
RELATION_CANDIDATE_RETRY_BACKOFF_SECONDS=2
RELATION_CANDIDATE_TIMEOUT_SECONDS=90
RELATION_CANDIDATE_LONG_PROMPT_TIMEOUT_SECONDS=180
RELATION_CANDIDATE_LONG_PROMPT_CHARS=6000

# Optional independent second review of already-extracted relation candidates.
# Keep this separate from RELATION_CANDIDATE_* so a different provider/model
# can judge Qwen's proposals without accidentally reusing its credentials.
# The review pipeline never changes candidates or writes graph edges.
RELATION_REVIEW_PROVIDER=disabled
RELATION_REVIEW_BASE_URL=
RELATION_REVIEW_API_KEY=
RELATION_REVIEW_MODEL=
# Leave blank for providers that do not support an enable_thinking request field.
RELATION_REVIEW_REQUEST_ENABLE_THINKING=
# Set false only when a compatible provider rejects response_format=json_object.
RELATION_REVIEW_JSON_MODE=true
RELATION_REVIEW_MAX_ATTEMPTS=3
RELATION_REVIEW_RETRY_BACKOFF_SECONDS=2
RELATION_REVIEW_TIMEOUT_SECONDS=120
RELATION_REVIEW_LONG_PROMPT_TIMEOUT_SECONDS=180
RELATION_REVIEW_LONG_PROMPT_CHARS=8000
RELATION_REVIEW_MAX_EVIDENCE_CHARS=9000

# Optional graph service, activated by the graph Compose profile.
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-local-neo4j-password
